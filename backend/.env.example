# =============================================================================
# M-Motors — Backend FastAPI
# Copier : cp .env.example .env
# Aucun secret ni mot de passe ne doit être commité : tout passe par ce fichier
# ou les variables d’environnement du conteneur / du CI.
# =============================================================================

# --- Obligatoires (plus de valeurs par défaut sensibles dans le code Python) ---
# Clé de signature JWT (ex. openssl rand -hex 32)
SECRET_KEY=

# URL SQLAlchemy synchrone (ex. PostgreSQL ou SQLite pour les tests)
DATABASE_URL=

# --- OpenTelemetry / Jaeger (optionnel) ---
# Ne pas utiliser l’URL Kubernetes en local Docker : ce nom ne se résout pas hors cluster.
# Docker Compose (service « jaeger » du fichier racine docker-compose.yml) :
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Backend lancé sur l’hôte, Jaeger en Docker avec ports 4318:4318 publiés :
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Pod Kubernetes (namespace monitoring) :
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger.monitoring.svc.cluster.local:4318
# Désactiver toute export OTel (tests, pas de collecteur) :
# OTEL_SDK_DISABLED=true
# Traces uniquement vers Jaeger (pas d’export OTLP des logs) :
# OTEL_LOGS_EXPORTER=none

# --- Optionnel ---
# ENV=test
# URL frontend utilisée pour générer le lien de confirmation email.
# FRONTEND_BASE_URL=https://netdevops.fr
# Configuration Resend pour l'envoi de l'email de vérification.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=M-Motors <no-reply@votre-domaine.com>
# Origines CORS autorisées : CSV ou JSON tableau, ex. :
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=["http://localhost:3000","http://mmotors-frontend:3000"]
# Endpoint S3 public pour les uploads navigateur (si différent de S3_ENDPOINT_URL).
# S3_PUBLIC_ENDPOINT_URL=https://s3-dev.netdevops.fr

# =============================================================================
# Exemples (décommenter / adapter — ne pas réutiliser tels quels en production)
# =============================================================================

# Tests unitaires (SQLite)
# SECRET_KEY=mmotors-ci-test-secret-do-not-use-in-production-min-32chars
# DATABASE_URL=sqlite:///./test.db

# Tests d’intégration / CI PostgreSQL
# ENV=test
# SECRET_KEY=mmotors-ci-test-secret-do-not-use-in-production-min-32chars
# DATABASE_URL=postgresql://mmotors:mmotors_test@localhost:5432/mmotors_test
# REDIS_URL=redis://localhost:6379/0

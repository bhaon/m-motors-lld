# ══════════════════════════════════════════════════════════════════════════════
#  M-Motors LLD — .gitignore
#  Monorepo : backend (FastAPI/Python) + frontend (Next.js/TypeScript) + k8s
# ══════════════════════════════════════════════════════════════════════════════


# ── Secrets & variables d'environnement ───────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
!frontend/.env.local.example

# Certificats / matériel cryptographique local (ne pas versionner)
*.pem
*.p12
*.pfx

# Secrets Kubernetes en clair — utiliser seal-secrets.sh pour générer les
# SealedSecrets chiffrés qui peuvent être commités en toute sécurité.
k8s/infra/dev/secrets.yaml
k8s/infra/staging/secrets.yaml
k8s/infra/production/secrets.yaml


# ── Python / FastAPI (backend) ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# Environnements virtuels (plusieurs conventions utilisées dans ce projet)
.venv/
.venv-ci/
.venv_ci/
venv/
env/
# Chemins explicites (évite toute ambiguïté avec l’historique Git du dépôt)
backend/.venv/
backend/.venv-ci/
backend/.venv_ci/

# Bases de données SQLite de test
*.db
*.sqlite
*.sqlite3

# Couverture Python
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage/

# Outils Python
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pytest_cache/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
wheels/
*.whl
sdist/
var/
MANIFEST


# ── Node.js / Next.js (frontend) ──────────────────────────────────────────────
node_modules/

# Build Next.js
.next/
out/

# Rapport de couverture Jest
frontend/coverage/

# Playwright (e2e) — sorties relatives à frontend/playwright.config.ts
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Turborepo / cache Next (si activé plus tard)
.turbo/

# Déploiement Vercel local
.vercel

# Cache TypeScript
*.tsbuildinfo

# Logs npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Caches outils JS
.eslintcache
.stylelintcache
.parcel-cache/
.cache/

# pnpm
.pnpm-store/

# yarn v3+
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions


# ── Outils CI / qualité (sorties locales) ─────────────────────────────────────
.scannerwork/
junit.xml
bandit-report.json
.zap/


# ── Éditeurs & OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# direnv (chemins machine-spécifiques)
.direnv/
.envrc


# ── Docker ────────────────────────────────────────────────────────────────────
# Ne pas ignorer les Dockerfiles et docker-compose ; les ignorer ici serait une
# erreur. On ignore uniquement les fichiers générés ou sensibles.
docker-compose.override.yml


# ── Divers ─────────────────────────────────────────────────────────────────────
*.pid
*.seed
*.tgz
*.lcov
*.orig
*.stackdump
.dccache

# Terraform / IaC local (si scripts ou stacks ajoutés hors k8s purs)
.terraform/
*.tfstate
*.tfstate.*
